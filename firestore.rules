rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Auth helpers ----------
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function mainAdminEmail() {
      return 'dibbay242-50-014@diu.edu.bd';
    }

    function mainAdminUid() {
      return 'fTTcLzM16dX1IFhep8URQRVmKE73';
    }

    function isMainAdmin() {
      return signedIn() && (
        request.auth.uid == mainAdminUid()
        || (
          request.auth.token.email != null
          && request.auth.token.email == mainAdminEmail()
        )
      );
    }

    function isListedAdmin() {
      return signedIn() && (
        exists(/databases/$(database)/documents/app_admins/$(request.auth.uid))
        || (
          request.auth.token.email != null
          && exists(/databases/$(database)/documents/app_admins/$(request.auth.token.email))
        )
      );
    }

    function isAdminUser() {
      return signedIn() && (
        request.auth.token.admin == true
        || isMainAdmin()
        || isListedAdmin()
      );
    }

    function isFlexibleDate(value) {
      return value == null
        || value is timestamp
        || (value is string && value.size() <= 80);
    }

    // ---------- User-state validators ----------
    function validProfile(profile) {
      return profile is map
        && (!('name' in profile) || (profile.name is string && profile.name.size() <= 120))
        && (!('email' in profile) || (profile.email is string && profile.email.size() <= 180))
        && (!('age' in profile) || (profile.age is number && profile.age >= 0 && profile.age <= 130))
        && (!('gender' in profile) || (profile.gender is string && profile.gender.size() <= 60))
        && (!('bloodGroup' in profile) || (profile.bloodGroup is string && profile.bloodGroup.size() <= 20))
        && (!('isBloodDonor' in profile) || profile.isBloodDonor is bool)
        && (!('donorContactInfo' in profile) || (profile.donorContactInfo is string && profile.donorContactInfo.size() <= 300))
        && (!('heightCm' in profile) || (profile.heightCm is number && profile.heightCm >= 0 && profile.heightCm <= 300))
        && (!('weightKg' in profile) || (profile.weightKg is number && profile.weightKg >= 0 && profile.weightKg <= 500))
        && (!('healthGoals' in profile) || (profile.healthGoals is string && profile.healthGoals.size() <= 1000))
        && (!('contactInfo' in profile) || (profile.contactInfo is string && profile.contactInfo.size() <= 1000))
        && (!('knownConditions' in profile) || (profile.knownConditions is string && profile.knownConditions.size() <= 1000))
        && (!('division' in profile) || (profile.division is string && profile.division.size() <= 80))
        && (!('district' in profile) || (profile.district is string && profile.district.size() <= 80))
        && (!('accountType' in profile) || (
          profile.accountType is string
          && (
            profile.accountType == 'patient'
            || profile.accountType == 'doctor'
            || profile.accountType == 'admin'
            || profile.accountType == ''
          )
        ));
    }

    function validState(data) {
      return data is map
        && data.profile is map
        && validProfile(data.profile)
        && (!('logs' in data) || (data.logs is list && data.logs.size() <= 500))
        && (!('chatSessions' in data) || (data.chatSessions is list && data.chatSessions.size() <= 50))
        && (!('chatMessages' in data) || (data.chatMessages is list && data.chatMessages.size() <= 500))
        && (!('activeChatSessionId' in data) || data.activeChatSessionId == null || data.activeChatSessionId is string)
        && (!('onboardingCompleted' in data) || data.onboardingCompleted is bool)
        && (!('updatedAt' in data) || isFlexibleDate(data.updatedAt));
    }

    function ownerStateCreateAllowed() {
      return signedIn()
        && request.resource.data is map
        && request.resource.data.profile is map
        && (
          !('accountType' in request.resource.data.profile)
          || request.resource.data.profile.accountType == 'patient'
          || request.resource.data.profile.accountType == ''
        );
    }

    function ownerStateUpdateAllowed() {
      return signedIn()
        && request.resource.data is map
        && request.resource.data.profile is map
        && (
          !('accountType' in request.resource.data.profile)
          || request.resource.data.profile.accountType == 'patient'
          || request.resource.data.profile.accountType == ''
          || (
            resource.data is map
            && resource.data.profile is map
            && ('accountType' in resource.data.profile)
            && request.resource.data.profile.accountType == resource.data.profile.accountType
          )
        );
    }

    // ---------- Admin validators ----------
    function validAdminRecord(data) {
      return data is map
        && data.email is string
        && data.email.size() <= 180
        && data.displayName is string
        && data.displayName.size() <= 140
        && data.addedBy is string
        && data.addedBy.size() <= 180
        && (!('uid' in data) || data.uid == null || (data.uid is string && data.uid.size() <= 180))
        && (!('createdAt' in data) || isFlexibleDate(data.createdAt))
        && (!('updatedAt' in data) || isFlexibleDate(data.updatedAt));
    }

    // ---------- Doctor validators ----------
    function validDoctorRecord(data) {
      return data is map
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 180
        && (!('category' in data) || data.category == null || (data.category is string && data.category.size() <= 140))
        && (!('division' in data) || data.division == null || (data.division is string && data.division.size() <= 120))
        && (!('district' in data) || data.district == null || (data.district is string && data.district.size() <= 120))
        && (!('doctorUserId' in data) || data.doctorUserId == null || (data.doctorUserId is string && data.doctorUserId.size() <= 180))
        && (!('doctorEmail' in data) || data.doctorEmail == null || (data.doctorEmail is string && data.doctorEmail.size() <= 180))
        && (!('displayName' in data) || data.displayName == null || (data.displayName is string && data.displayName.size() <= 180))
        && (!('authEmail' in data) || data.authEmail == null || (data.authEmail is string && data.authEmail.size() <= 180))
        && (!('qualification' in data) || data.qualification == null || (data.qualification is string && data.qualification.size() <= 1200))
        && (!('specialtySummary' in data) || data.specialtySummary == null || (data.specialtySummary is string && data.specialtySummary.size() <= 1200))
        && (!('details' in data) || data.details == null || (data.details is string && data.details.size() <= 2000))
        && (!('contact' in data) || data.contact == null || (data.contact is string && data.contact.size() <= 220))
        && (!('contactInfo' in data) || data.contactInfo == null || (data.contactInfo is string && data.contactInfo.size() <= 220))
        && (!('chamber' in data) || data.chamber == null || (data.chamber is string && data.chamber.size() <= 3000))
        && (!('availableDays' in data) || data.availableDays == null || data.availableDays is list || data.availableDays is string)
        && (!('chambers' in data) || data.chambers == null || (data.chambers is list && data.chambers.size() <= 10))
        && (!('rating' in data) || (data.rating is number && data.rating >= 0 && data.rating <= 5))
        && (!('ratingCount' in data) || (data.ratingCount is number && data.ratingCount >= 0))
        && (!('hasDedicatedProfile' in data) || data.hasDedicatedProfile is bool)
        && (!('acceptsAppointments' in data) || data.acceptsAppointments is bool)
        && (!('photoDataUrl' in data) || data.photoDataUrl == null || (data.photoDataUrl is string && data.photoDataUrl.size() <= 500000))
        && (!('doctorPhotoDataUrl' in data) || data.doctorPhotoDataUrl == null || (data.doctorPhotoDataUrl is string && data.doctorPhotoDataUrl.size() <= 500000))
        && (!('imageDataUrl' in data) || data.imageDataUrl == null || (data.imageDataUrl is string && data.imageDataUrl.size() <= 500000))
        && (!('photoUpdatedAt' in data) || isFlexibleDate(data.photoUpdatedAt))
        && (!('createdAt' in data) || isFlexibleDate(data.createdAt))
        && (!('updatedAt' in data) || isFlexibleDate(data.updatedAt));
    }

    function doctorLinkedToAuth(data) {
      return signedIn()
        && data is map
        && (
          data.doctorUserId == request.auth.uid
          || (
            request.auth.token.email != null
            && (
              data.authEmail == request.auth.token.email
              || data.doctorEmail == request.auth.token.email
              || data.email == request.auth.token.email
            )
          )
        );
    }

    function doctorProtectedFieldsUnchanged() {
      return (!('doctorUserId' in resource.data) || request.resource.data.doctorUserId == resource.data.doctorUserId)
        && (!('hasDedicatedProfile' in resource.data) || request.resource.data.hasDedicatedProfile == resource.data.hasDedicatedProfile)
        && (!('acceptsAppointments' in resource.data) || request.resource.data.acceptsAppointments == resource.data.acceptsAppointments)
        && (!('rating' in resource.data) || request.resource.data.rating == resource.data.rating)
        && (!('ratingCount' in resource.data) || request.resource.data.ratingCount == resource.data.ratingCount);
    }

    function validDoctorSelfScheduleUpdate(docId) {
      return doctorLinkedToAuth(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'chambers',
          'chamber',
          'availableDays',
          'updatedAt',
          'id'
        ])
        && (!('id' in request.resource.data) || request.resource.data.id == docId)
        && (!('chamber' in request.resource.data) || request.resource.data.chamber == null || (request.resource.data.chamber is string && request.resource.data.chamber.size() <= 3000))
        && (!('availableDays' in request.resource.data) || request.resource.data.availableDays == null || request.resource.data.availableDays is list || request.resource.data.availableDays is string)
        && (!('chambers' in request.resource.data) || request.resource.data.chambers == null || (request.resource.data.chambers is list && request.resource.data.chambers.size() <= 10))
        && (!('updatedAt' in request.resource.data) || isFlexibleDate(request.resource.data.updatedAt));
    }

    function validDoctorSelfProfileUpdate() {
      return doctorLinkedToAuth(resource.data)
        && doctorProtectedFieldsUnchanged()
        && validDoctorRecord(request.resource.data);
    }

    function validDoctorRatingAggregateUpdate(docId) {
      return signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'rating',
          'ratingCount',
          'updatedAt'
        ])
        && request.resource.data.rating is number
        && request.resource.data.rating >= 0
        && request.resource.data.rating <= 5
        && request.resource.data.ratingCount is number
        && request.resource.data.ratingCount >= 0
        && exists(/databases/$(database)/documents/doctor_ratings/$(docId + '_' + request.auth.uid))
        && validDoctorRecord(request.resource.data);
    }

    // ---------- Appointment validators ----------
    function isBookableDedicatedDoctor(data) {
      return data.doctorId is string
        && data.doctorId.size() > 0
        && exists(/databases/$(database)/documents/doctors/$(data.doctorId))
        && get(/databases/$(database)/documents/doctors/$(data.doctorId)).data.hasDedicatedProfile == true
        && get(/databases/$(database)/documents/doctors/$(data.doctorId)).data.acceptsAppointments != false
        && get(/databases/$(database)/documents/doctors/$(data.doctorId)).data.doctorUserId is string
        && get(/databases/$(database)/documents/doctors/$(data.doctorId)).data.doctorUserId.size() > 0
        && get(/databases/$(database)/documents/doctors/$(data.doctorId)).data.doctorUserId == data.doctorUserId;
    }

    function validAppointmentCreate(data) {
      return signedIn()
        && data is map
        && data.patientUid == request.auth.uid
        && data.doctorId is string
        && data.doctorId.size() > 0
        && data.doctorUserId is string
        && data.doctorUserId.size() > 0
        && isBookableDedicatedDoctor(data)
        && data.patientName is string
        && data.patientName.size() > 0
        && data.patientName.size() <= 180
        && (!('appointmentAt' in data) || isFlexibleDate(data.appointmentAt))
        && (!('chamberId' in data) || data.chamberId == null || (data.chamberId is string && data.chamberId.size() <= 120))
        && (!('chamberName' in data) || data.chamberName == null || (data.chamberName is string && data.chamberName.size() <= 220))
        && (!('timeBlockId' in data) || data.timeBlockId == null || (data.timeBlockId is string && data.timeBlockId.size() <= 120))
        && (!('timeBlockLabel' in data) || data.timeBlockLabel == null || (data.timeBlockLabel is string && data.timeBlockLabel.size() <= 120))
        && (!('slotMaxPatients' in data) || data.slotMaxPatients == null || (data.slotMaxPatients is number && data.slotMaxPatients >= 1 && data.slotMaxPatients <= 500))
        && (!('status' in data) || (
          data.status == 'pending'
          || data.status == 'confirmed'
          || data.status == 'cancelled'
          || data.status == 'completed'
        ))
        && (!('reason' in data) || data.reason == null || (data.reason is string && data.reason.size() <= 1000));
    }

    function validAppointmentStatus(status) {
      return status == 'pending'
        || status == 'confirmed'
        || status == 'cancelled'
        || status == 'completed';
    }

    function appointmentIdentityUnchanged() {
      return request.resource.data.patientUid == resource.data.patientUid
        && request.resource.data.doctorUserId == resource.data.doctorUserId
        && request.resource.data.doctorId == resource.data.doctorId;
    }

    function appointmentStatusOnlyUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'updatedAt',
          'serialNumber',
          'serialAssignedAt'
        ])
        && appointmentIdentityUnchanged()
        && validAppointmentStatus(request.resource.data.status)
        && (!('serialNumber' in request.resource.data)
          || request.resource.data.serialNumber == null
          || (request.resource.data.serialNumber is string && request.resource.data.serialNumber.size() > 0 && request.resource.data.serialNumber.size() <= 30)
          || (request.resource.data.serialNumber is number && request.resource.data.serialNumber >= 1 && request.resource.data.serialNumber <= 9999));
    }

    function doctorAppointmentStatusUpdateAllowed() {
      return signedIn()
        && (isAdminUser() || resource.data.doctorUserId == request.auth.uid)
        && appointmentStatusOnlyUpdate();
    }

    function patientAppointmentCancelAllowed() {
      return signedIn()
        && resource.data.patientUid == request.auth.uid
        && appointmentStatusOnlyUpdate()
        && request.resource.data.status == 'cancelled'
        && (resource.data.status == 'pending' || resource.data.status == 'confirmed');
    }

    function validCompletedAppointmentRating(data) {
      return data.appointmentId is string
        && data.appointmentId.size() > 0
        && exists(/databases/$(database)/documents/doctor_appointments/$(data.appointmentId))
        && get(/databases/$(database)/documents/doctor_appointments/$(data.appointmentId)).data.patientUid == request.auth.uid
        && get(/databases/$(database)/documents/doctor_appointments/$(data.appointmentId)).data.doctorId == data.doctorId
        && get(/databases/$(database)/documents/doctor_appointments/$(data.appointmentId)).data.doctorUserId == data.doctorUserId
        && get(/databases/$(database)/documents/doctor_appointments/$(data.appointmentId)).data.status == 'completed';
    }

    function validRating(data) {
      return signedIn()
        && data is map
        && data.patientUid == request.auth.uid
        && data.doctorId is string
        && data.doctorId.size() > 0
        && data.doctorUserId is string
        && data.doctorUserId.size() > 0
        && validCompletedAppointmentRating(data)
        && data.rating is number
        && data.rating >= 1
        && data.rating <= 5
        && (!('review' in data) || data.review == null || (data.review is string && data.review.size() <= 1000));
    }

    // ---------- Public donor / disabled-account validators ----------
    function validPublicDonorRecord(data) {
      return data is map
        && data.keys().hasOnly([
          'id',
          'type',
          'name',
          'contact',
          'contactInfo',
          'phone',
          'address',
          'location',
          'bloodGroup',
          'division',
          'district',
          'gender',
          'note',
          'details',
          'isBloodDonor',
          'source',
          'updatedAt'
        ])
        && (!('id' in data) || data.id == null || (data.id is string && data.id.size() <= 180))
        && (!('type' in data) || data.type == 'donor')
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 140
        && (!('contact' in data) || data.contact == null || (data.contact is string && data.contact.size() <= 180))
        && (!('contactInfo' in data) || data.contactInfo == null || (data.contactInfo is string && data.contactInfo.size() <= 180))
        && (!('phone' in data) || data.phone == null || (data.phone is string && data.phone.size() <= 180))
        && (!('address' in data) || data.address == null || (data.address is string && data.address.size() <= 300))
        && (!('location' in data) || data.location == null || (data.location is string && data.location.size() <= 300))
        && data.bloodGroup is string
        && (
          data.bloodGroup == 'A+'
          || data.bloodGroup == 'A-'
          || data.bloodGroup == 'B+'
          || data.bloodGroup == 'B-'
          || data.bloodGroup == 'AB+'
          || data.bloodGroup == 'AB-'
          || data.bloodGroup == 'O+'
          || data.bloodGroup == 'O-'
        )
        && (!('division' in data) || data.division == null || (data.division is string && data.division.size() <= 80))
        && (!('district' in data) || data.district == null || (data.district is string && data.district.size() <= 80))
        && (!('gender' in data) || data.gender == null || (data.gender is string && data.gender.size() <= 60))
        && (!('note' in data) || data.note == null || (data.note is string && data.note.size() <= 500))
        && (!('details' in data) || data.details == null || (data.details is string && data.details.size() <= 500))
        && (!('isBloodDonor' in data) || data.isBloodDonor is bool)
        && (!('source' in data) || (data.source is string && data.source.size() <= 40))
        && (!('updatedAt' in data) || isFlexibleDate(data.updatedAt));
    }

    function validDisabledAccount(data, userId) {
      return data is map
        && data.keys().hasOnly([
          'uid',
          'email',
          'label',
          'reason',
          'disabled',
          'disabledBy',
          'disabledByEmail',
          'disabledAt',
          'updatedAt'
        ])
        && data.uid == userId
        && data.disabled is bool
        && (!('email' in data) || data.email == null || (data.email is string && data.email.size() <= 180))
        && (!('label' in data) || data.label == null || (data.label is string && data.label.size() <= 180))
        && (!('reason' in data) || data.reason == null || (data.reason is string && data.reason.size() <= 300))
        && (!('disabledBy' in data) || data.disabledBy == null || (data.disabledBy is string && data.disabledBy.size() <= 180))
        && (!('disabledByEmail' in data) || data.disabledByEmail == null || (data.disabledByEmail is string && data.disabledByEmail.size() <= 180))
        && (!('disabledAt' in data) || isFlexibleDate(data.disabledAt))
        && (!('updatedAt' in data) || isFlexibleDate(data.updatedAt));
    }

    // ---------- Admin collection-group access ----------
    match /{path=**}/app/{appDocId} {
      allow get, list: if isAdminUser();
    }

    // ---------- User app state ----------
    match /users/{userId} {
      allow get, list: if false;
      allow delete: if isOwner(userId) || isAdminUser();

      match /app/state {
        allow get: if isOwner(userId) || isAdminUser();
        allow list: if isAdminUser();
        allow create: if (isOwner(userId) && ownerStateCreateAllowed()) || isAdminUser();
        allow update: if (isOwner(userId) && ownerStateUpdateAllowed()) || isAdminUser();
        allow delete: if isOwner(userId) || isAdminUser();
      }
    }

    // ---------- Admin records ----------
    match /app_admins/{adminId} {
      allow get: if signedIn() && (
        adminId == request.auth.uid
        || (request.auth.token.email != null && adminId == request.auth.token.email)
        || isAdminUser()
      );
      allow list: if isAdminUser();
      allow create, update: if (isMainAdmin() || request.auth.token.admin == true)
        && validAdminRecord(request.resource.data);
      allow delete: if isMainAdmin()
        || request.auth.token.admin == true
        || (
          signedIn()
          && (
            adminId == request.auth.uid
            || (request.auth.token.email != null && adminId == request.auth.token.email)
          )
        );
    }

    // ---------- Doctor directory ----------
    match /doctors/{docId} {
      allow read: if true;
      allow create: if isAdminUser() && validDoctorRecord(request.resource.data);
      allow update: if (isAdminUser() && validDoctorRecord(request.resource.data))
        || validDoctorSelfScheduleUpdate(docId)
        || validDoctorSelfProfileUpdate()
        || validDoctorRatingAggregateUpdate(docId);
      allow delete: if isAdminUser()
        || (signedIn() && resource.data.doctorUserId == request.auth.uid);
    }

    match /doctor_categories/{catId} {
      allow read: if true;
      allow create, update, delete: if isAdminUser();
    }

    // ---------- Emergency resources ----------
    match /emergency_resources/{resId} {
      allow read: if true;
      allow create, update, delete: if isAdminUser();
    }

    // ---------- Blood donors ----------
    match /blood_donors/{donorId} {
      allow read: if true;
      allow create, update: if (isAdminUser() || isOwner(donorId))
        && validPublicDonorRecord(request.resource.data);
      allow delete: if isAdminUser() || isOwner(donorId);
    }

    // ---------- Doctor appointments ----------
    match /doctor_appointments/{appointmentId} {
      allow get: if signedIn() && (
        isAdminUser()
        || resource.data.patientUid == request.auth.uid
        || resource.data.doctorUserId == request.auth.uid
      );
      allow list: if signedIn() && (
        isAdminUser()
        || resource.data.patientUid == request.auth.uid
        || resource.data.doctorUserId == request.auth.uid
      );
      allow create: if validAppointmentCreate(request.resource.data);
      allow update: if doctorAppointmentStatusUpdateAllowed()
        || patientAppointmentCancelAllowed();
      allow delete: if signedIn() && (
        isAdminUser()
        || resource.data.patientUid == request.auth.uid
        || resource.data.doctorUserId == request.auth.uid
      );
    }

    // ---------- Doctor ratings ----------
    match /doctor_ratings/{ratingId} {
      allow read: if true;
      allow create, update: if validRating(request.resource.data);
      allow delete: if signedIn() && (
        isAdminUser()
        || resource.data.patientUid == request.auth.uid
        || resource.data.doctorUserId == request.auth.uid
      );
    }

    // ---------- Disabled app accounts ----------
    match /disabled_accounts/{userId} {
      allow get: if isOwner(userId) || isAdminUser();
      allow list: if isAdminUser();
      allow create, update: if isAdminUser() && validDisabledAccount(request.resource.data, userId);
      allow delete: if isAdminUser();
    }

    // ---------- Admin audit logs ----------
    match /audit_logs/{logId} {
      allow get, list: if isAdminUser();
      allow create: if isAdminUser()
        && request.resource.data is map
        && request.resource.data.action is string
        && request.resource.data.action.size() > 0
        && request.resource.data.action.size() <= 80
        && request.resource.data.targetType is string
        && request.resource.data.targetType.size() <= 80
        && request.resource.data.targetId is string
        && request.resource.data.targetId.size() <= 180
        && request.resource.data.label is string
        && request.resource.data.label.size() <= 240
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.actorEmail is string
        && request.resource.data.actorEmail.size() <= 180
        && request.resource.data.details is map;
      allow update: if false;
      allow delete: if isMainAdmin() || request.auth.token.admin == true;
    }

    // ---------- Final deny ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
